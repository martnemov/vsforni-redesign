 # Media CDN base URL (files in /uploads/media/ are served from here)
PUBLIC_MEDIA_BASE_URL=

# Yandex SMTP
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=vsfornirus@yandex.ru
SMTP_PASS=your_app_password_here
SMTP_TO=vsfornirus@yandex.ru

# Yandex SmartCaptcha (https://cloud.yandex.ru/services/smartcaptcha)
SMARTCAPTCHA_SERVER_KEY=
SMARTCAPTCHA_CLIENT_KEY=

# Telegram bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Yandex Metrika counter ID
YANDEX_METRIKA_ID=

# Logs directory (optional, default: ./logs)
LOGS_DIR=
