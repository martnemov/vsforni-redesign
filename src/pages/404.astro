---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import { useTranslations, getLang, localizeUrl } from '@/i18n';
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---
<BaseLayout title="404 — Страница не найдена" noindex>
  <main class="nf">
    <div class="container nf__inner">
      <span class="nf__code">404</span>
      <h1 class="nf__title">{t.notFoundTitle}</h1>
      <p class="nf__text">{t.notFoundText}</p>
      <div class="nf__actions">
        <Button href={localizeUrl("/", lang)} variant="primary" size="lg">{t.toHome}</Button>
        <Button href={localizeUrl("/katalog-oborudovaniya-vs-forni/", lang)} variant="outline" size="lg">{t.catalog}</Button>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .nf { display: flex; align-items: center; min-height: 60vh; }
  .nf__inner { text-align: center; max-width: 56ch; margin-inline: auto; }
  .nf__code { font-family: var(--font-display); font-weight: 800; font-size: clamp(5rem, 18vw, 11rem); line-height: 1; color: var(--copper-bright); letter-spacing: -.04em; display: block; }
  .nf__title { font-size: var(--font-2xl); margin: var(--sp-3) 0 var(--sp-4); }
  .nf__text { color: var(--color-text-muted); font-size: var(--font-lg); margin-bottom: var(--sp-6); }
  .nf__actions { display: flex; gap: var(--sp-4); justify-content: center; flex-wrap: wrap; }
</style>
