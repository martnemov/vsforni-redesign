---
export const prerender = true;
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import ProductSpecsTable from '@/components/product/ProductSpecsTable.astro';
import RelatedProducts from '@/components/product/RelatedProducts.astro';
import Button from '@/components/ui/Button.astro';
import Modal from '@/components/forms/Modal.astro';
import { useTranslations, getLang, localizeUrl } from '@/i18n';
import BackButton from '@/components/ui/BackButton.astro';
import { catalogUrl, groupUrl, mediaUrl } from '@/lib/utils';

export async function getStaticPaths() {
  const products = await getCollection('products');
  const groups = await getCollection('groups');
  const categories = await getCollection('categories');
  return products.map((prod: CollectionEntry<'products'>) => ({
    params: {
      category: prod.data.categorySlug,
      group: prod.data.groupSlug,
      product: prod.data.urlSlug,
    },
    props: {
      prod,
      grp: groups.find((g: CollectionEntry<'groups'>) => g.data.urlSlug === prod.data.groupSlug && g.data.categorySlug === prod.data.categorySlug),
      cat: categories.find((c: CollectionEntry<'categories'>) => c.data.urlSlug === prod.data.categorySlug),
    },
  }));
}

interface Props { prod: CollectionEntry<'products'>; grp?: CollectionEntry<'groups'>; cat?: CollectionEntry<'categories'>; }
const { prod, grp, cat } = Astro.props;
const { category, group } = Astro.params;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

// siblings for related products
const allProducts = await getCollection('products');
const siblings = allProducts
  .filter((p: CollectionEntry<'products'>) => p.data.groupSlug === group && p.data.categorySlug === category)
  .map((p: CollectionEntry<'products'>) => ({ id: p.data.id, title: p.data.longTitle || p.data.title, image: p.data.image, astroUri: p.data.astroUri }));

const d = prod.data;
const h1 = d.longTitle || d.title;
const modelCode = d.longTitle && d.longTitle !== d.title ? d.title : null;
const highlights = d.specs.filter((s: {label:string;value:string}) => s.value).slice(0, 4);
const telHref = `tel:${t.phone.replace(/\s|\(|\)|-/g, '')}`;

const breadcrumbs = [
  { label: t.breadcrumbHome, href: localizeUrl('/', lang) },
  { label: t.catalog, href: localizeUrl('/katalog-oborudovaniya-vs-forni/', lang) },
  { label: cat?.data.title ?? category, href: localizeUrl(catalogUrl(category), lang) },
  { label: grp?.data.title ?? group, href: localizeUrl(groupUrl(category, group), lang) },
  { label: d.title },
];

const jsonLdProduct = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: h1,
  image: new URL(mediaUrl(d.image), Astro.site!).href,
  description: d.seo.description || undefined,
  manufacturer: { '@type': 'Organization', name: t.siteName },
  ...(d.specs.filter((s: {label:string;value:string}) => s.value).length > 0 && {
    additionalProperty: d.specs.filter((s: {label:string;value:string}) => s.value).map((s: {label:string;value:string}) => ({
      '@type': 'PropertyValue',
      name: s.label,
      value: s.value,
    })),
  }),
};
---
<BaseLayout
  title={d.seo.title || h1}
  description={d.seo.description}
  ogImage={mediaUrl(d.seo.ogImage)}
>
  <main>
    <div class="phero-strip">
      <div class="container">
        <div class="page-nav">
          <BackButton href={localizeUrl(groupUrl(category, group), lang)} label={grp?.data?.title ?? group} />
          <Breadcrumbs items={breadcrumbs} site={Astro.site!} />
        </div>
      </div>
    </div>

    <section class="product">
      <div class="container">
        <div class="product-layout">
          <div class="product-media">
            <img class="product-img" src={mediaUrl(d.image)} alt={h1} width="640" height="480" loading="eager" decoding="async" />
          </div>
          <div class="product-info">
            {modelCode && <div class="product-info__model">{t.sku} · {modelCode}</div>}
            <h1 class="product-title">{h1}</h1>
            {d.description && <p class="product-desc">{d.description}</p>}

            {highlights.length > 0 && (
              <div class="product-hl">
                {highlights.map((s: {label:string;value:string}) => (
                  <div class="product-hl__it">
                    <div class="product-hl__l">{s.label}</div>
                    <div class="product-hl__v">{s.value}</div>
                  </div>
                ))}
              </div>
            )}

            <div class="product-actions">
              <Button variant="primary" size="lg" data-modal="modal-price">{t.requestPrice}</Button>
              <a href={telHref} class="product-phone">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
                {t.phone}
              </a>
            </div>

            <div class="product-trust">
              <span class="product-trust__it"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>{t.trustProductDelivery}</span>
              <span class="product-trust__it"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2-2z"/></svg>{t.trustInstall}</span>
              <span class="product-trust__it"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.5 8 8 11 4.5-3 8-6 8-11V5z"/></svg>{t.trustWarranty}</span>
            </div>
          </div>
        </div>

        <ProductSpecsTable specs={d.specs} />

        {d.content && <div class="product-content" set:html={d.content} />}

        <RelatedProducts products={siblings} currentId={d.id} />
      </div>
    </section>
  </main>

  <Modal id="modal-price" title={t.requestPrice} formType="price-request" productTitle={h1} />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdProduct)} />
</BaseLayout>

<style>
  .phero-strip { background: var(--paper); border-bottom: 1px solid var(--color-border); }
  .product { padding-block: clamp(1.5rem, 4vw, 3rem); }

  .product-layout { display: grid; grid-template-columns: 1fr; gap: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: var(--sp-8); }
  .product-img { width: 100%; aspect-ratio: 4/3; border-radius: var(--radius-lg); border: 1px solid var(--color-border); box-shadow: var(--shadow-card); object-fit: contain; background: var(--surface); }
  .product-info__model { font-family: var(--font-mono); font-size: var(--font-sm); color: var(--accent-text); text-transform: uppercase; letter-spacing: .12em; margin-bottom: var(--sp-2); }
  .product-title { font-size: var(--font-2xl); margin-bottom: var(--sp-3); }
  .product-desc { color: var(--color-text-muted); font-size: var(--font-lg); margin-bottom: var(--sp-5); }
  .product-hl { display: grid; grid-template-columns: 1fr; gap: var(--sp-3); margin-bottom: var(--sp-5); }
  .product-hl__it { background: var(--surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--sp-3) var(--sp-4); display: flex; gap: var(--sp-3); align-items: baseline; }
  .product-hl__l { font-family: var(--font-mono); font-size: var(--font-xs); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: .06em; flex-shrink: 0; }
  .product-hl__v { font-size: var(--font-lg); color: var(--ink-900); font-weight: 600; }
  .product-actions { display: flex; flex-direction: column; gap: var(--sp-3); margin-bottom: var(--sp-5); }
  .product-phone { font-family: var(--font-mono); font-weight: 500; font-size: var(--font-base); color: var(--ink-900); display: inline-flex; align-items: center; gap: .5em; min-height: 44px; }
  .product-phone svg { width: 1.05em; height: 1.05em; color: var(--accent); }
  .product-phone:hover { color: var(--accent-text); }
  .product-trust { display: flex; flex-direction: column; gap: var(--sp-3); font-size: var(--font-sm); color: var(--color-text-muted); }
  .product-trust__it { display: inline-flex; align-items: center; gap: .5em; }
  .product-trust__it svg { width: 1.1em; height: 1.1em; color: var(--accent); flex-shrink: 0; }
  .product-content { margin-block: var(--sp-8); line-height: var(--line-height); max-width: 70ch; }

  @media (min-width: 480px) {
    .product-hl { grid-template-columns: 1fr 1fr; }
    .product-hl__it { flex-direction: column; }
    .product-actions { flex-direction: row; flex-wrap: wrap; align-items: center; }
    .product-trust { flex-direction: row; flex-wrap: wrap; gap: var(--sp-5); }
  }

  @media (min-width: 768px) {
    .product-layout { grid-template-columns: 1fr 1fr; }
    .product-media { position: sticky; top: var(--sp-6); align-self: start; }
    .product-img { aspect-ratio: auto; height: auto; }
  }
</style>
