---
export const prerender = true;
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/ui/Breadcrumbs.astro';
import ProductCard from '../../../../../components/product/ProductCard.astro';
import { useTranslations, getLang, localizeUrl, plural as plr } from '../../../../../i18n';
import { catalogUrl, productUrl, mediaUrl } from '../../../../../lib/utils';

export async function getStaticPaths() {
  const groups = await getCollection('groups');
  const products = await getCollection('products');
  return groups.map((grp: CollectionEntry<'groups'>) => ({
    params: { category: grp.data.categorySlug, group: grp.data.urlSlug },
    props: {
      grp,
      products: products.filter((p: CollectionEntry<'products'>) => p.data.groupSlug === grp.data.urlSlug && p.data.categorySlug === grp.data.categorySlug),
    },
  }));
}

interface Props {
  grp: CollectionEntry<'groups'>;
  products: CollectionEntry<'products'>[];
}
const { grp, products } = Astro.props;
const { category } = Astro.params;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const breadcrumbs = [
  { label: t.breadcrumbHome, href: localizeUrl('/', lang) },
  { label: t.catalog, href: localizeUrl('/katalog-oborudovaniya-vs-forni/', lang) },
  { label: category, href: localizeUrl(catalogUrl(category), lang) },
  { label: grp.data.title },
];

const pageTitle = grp.data.title;
const description = grp.data.description || `${grp.data.title} — каталог моделей VS FORNI. ${grp.data.productCount} модели.`;
const count = products.length;
const plural = plr(lang, count, ['модель','модели','моделей'], ['model','models']);
---
<BaseLayout title={pageTitle} description={description} ogImage={mediaUrl(grp.data.image)}>
  <main>
    <section class="phero">
      <div class="container">
        <Breadcrumbs items={breadcrumbs} site={Astro.site!} />
        <span class="kicker">{t.catalog}</span>
        <h1>{grp.data.title}</h1>
        {grp.data.description && <p class="phero__lead">{grp.data.description}</p>}
        <div class="phero__meta"><span><b>{count}</b> {plural} {t.inGroup}</span></div>
      </div>
    </section>

    <section class="catpage">
      <div class="container">
        <div class="catalog-tools">
          <div class="filter-stub">
            <span class="chip-stub">{t.filterPerf} ▾</span>
            <span class="chip-stub">{t.filterEnergy} ▾</span>
            <span class="chip-stub">{t.filterDims} ▾</span>
          </div>
          <span class="filter-stub__soon">{t.filterSoon}</span>
        </div>
        <div class="products-grid">
          {products.map((prod: CollectionEntry<'products'>) => (
            <ProductCard
              title={prod.data.longTitle || prod.data.title}
              image={prod.data.image}
              href={localizeUrl(productUrl(prod.data.astroUri), lang)}
              groupTitle={grp.data.title}
            />
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .phero { background: linear-gradient(var(--paper), var(--paper-2)); border-bottom: 1px solid var(--color-border); padding-block: var(--sp-2) var(--sp-8); }
  .kicker { font-family: var(--font-mono); font-size: var(--font-xs); text-transform: uppercase; letter-spacing: .22em; color: var(--accent-text); display: inline-flex; align-items: center; gap: .6em; }
  .kicker::before { content: ""; width: 1.6em; height: 1px; background: var(--accent-text); }
  .phero h1 { font-size: var(--font-3xl); margin-top: var(--sp-3); }
  .phero__lead { color: var(--color-text-muted); font-size: var(--font-md, var(--font-lg)); max-width: 60ch; margin-top: var(--sp-4); }
  .phero__meta { font-family: var(--font-mono); font-size: var(--font-xs); color: var(--color-text-muted); margin-top: var(--sp-4); }
  .phero__meta b { color: var(--accent-text); }

  .catalog-tools { display: flex; align-items: center; gap: var(--sp-4); flex-wrap: wrap; margin-bottom: var(--sp-6); }
  .filter-stub { display: flex; gap: var(--sp-2); flex-wrap: wrap; }
  .chip-stub { font-family: var(--font-mono); font-size: var(--font-xs); border: 1px dashed var(--copper-200); color: var(--accent-text); padding: .55em .9em; border-radius: var(--radius-md); }
  .filter-stub__soon { font-family: var(--font-mono); font-size: .66rem; text-transform: uppercase; letter-spacing: .1em; background: var(--copper-50); color: var(--accent-text); padding: .3em .6em; border-radius: var(--radius-sm); }

  .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--sp-5); padding-bottom: var(--sp-6); }
</style>
