---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import CatalogSection from '../components/sections/CatalogSection.astro';
import GeographySection from '../components/sections/GeographySection.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import DesignSection from '../components/sections/DesignSection.astro';
import LeasingSection from '../components/sections/LeasingSection.astro';
import CallbackSection from '../components/sections/CallbackSection.astro';
import Modal from '../components/forms/Modal.astro';
import { useTranslations, getLang } from '../i18n';
const t = useTranslations(getLang(Astro.currentLocale));

const jsonLdOrg = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: t.siteName,
  url: 'https://vsforni.ru',
  telephone: t.phone,
  email: t.email,
  address: { '@type': 'PostalAddress', addressCountry: 'RU', addressLocality: t.address },
};

const jsonLdWebsite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: t.siteName,
  url: 'https://vsforni.ru',
};
---
<BaseLayout title={t.siteName} description={t.siteDescription}>
  <HeroSection />
  <main>
    <CatalogSection />
    <GeographySection />
    <ServicesSection />
    <DesignSection />
    <LeasingSection />
    <CallbackSection />
  </main>
  <Modal id="modal-callback" title={t.requestCall} formType="callback" />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdOrg)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdWebsite)} />
</BaseLayout>
