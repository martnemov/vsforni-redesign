---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import { useTranslations, getLang, localizeUrl } from '../i18n';
import { mediaUrl } from '../lib/utils';
import BackButton from '../components/ui/BackButton.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const breadcrumbs = [
  { label: t.breadcrumbHome, href: localizeUrl('/', lang) },
  { label: t.historyTitle },
];

const stats = [
  { num: '80+', label: t.statCountries },
  { num: '167', label: t.statModels },
  { num: '6', label: t.statCategories },
];
---
<BaseLayout
  title={t.historyTitle}
  description="История компании VS FORNI — производителя хлебопекарного и кондитерского оборудования."
>
  <main>
    <section class="phero">
      <div class="container">
        <Breadcrumbs items={breadcrumbs} site={Astro.site!} />
        <BackButton href={localizeUrl('/', lang)} label={t.home} />
        <h1>{t.historyTitle}</h1>
        <p class="phero__lead">{t.historyLead}</p>
      </div>
    </section>

    <section class="history">
      <div class="container">
        <div class="history-layout">
          <div class="history-content">
            <p>{t.historyP1}</p>
            <p>{t.historyP2}</p>
            <p>{t.historyP3}</p>
          </div>
          <div class="history-aside">
            <img src={mediaUrl('/uploads/img/equip.jpg')} alt="Оборудование VS FORNI" loading="lazy" decoding="async" width="560" height="400" />
          </div>
        </div>

        <div class="history-stats">
          {stats.map((s) => (
            <div class="stat">
              <span class="stat__num">{s.num}</span>
              <span class="stat__label">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .phero { background: linear-gradient(var(--paper), var(--paper-2)); border-bottom: 1px solid var(--color-border); padding-block: var(--sp-2) var(--sp-8); }
  .phero h1 { font-size: var(--font-3xl); margin-top: var(--sp-3); }
  .phero__lead { color: var(--color-text-muted); font-size: var(--font-lg); max-width: 60ch; margin-top: var(--sp-4); }

  .history-layout { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(2rem, 4vw, 4rem); align-items: start; }
  .history-content p { color: var(--color-text); font-size: var(--font-lg); }
  .history-aside img { width: 100%; border-radius: var(--radius-lg); border: 1px solid var(--color-border); box-shadow: var(--shadow-card); }

  .history-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-5); margin-top: var(--sp-10); }
  .stat { border-left: 3px solid var(--accent); padding-left: var(--sp-4); }
  .stat__num { display: block; font-family: var(--font-display); font-size: var(--font-2xl); font-weight: 700; color: var(--ink-900); line-height: 1; }
  .stat__label { font-size: var(--font-sm); color: var(--color-text-muted); margin-top: var(--sp-2); display: block; }

  @media (max-width: 767px) {
    .history-layout { grid-template-columns: 1fr; }
    .history-aside { order: -1; }
    .history-stats { grid-template-columns: 1fr; gap: var(--sp-4); }
  }
</style>
