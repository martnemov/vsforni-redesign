---
import { useTranslations, getLang } from '../../i18n';
import { mediaUrl } from '../../lib/utils';

interface Props {
  title: string;
  image: string;
  href: string;
  groupTitle?: string;
}
const { title, image, href, groupTitle } = Astro.props;
const t = useTranslations(getLang(Astro.currentLocale));
---
<article class="product-card">
  <a href={href} class="product-card__img" tabindex="-1" aria-hidden="true">
    {groupTitle && <span class="product-card__tag">{groupTitle}</span>}
    <img src={mediaUrl(image)} alt={title} loading="lazy" decoding="async" width="360" height="260" />
  </a>
  <div class="product-card__body">
    <h3 class="product-card__title"><a href={href}>{title}</a></h3>
    <div class="product-card__foot">
      <span class="product-card__status">{t.onOrder}</span>
      <a href={href} class="product-card__more">{t.moreDetails} →</a>
    </div>
  </div>
</article>

<style>
  .product-card { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition); }
  .product-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-hover); border-color: var(--copper-200); }
  .product-card__img { position: relative; display: block; aspect-ratio: 4/3; overflow: hidden; background: linear-gradient(135deg, var(--paper-2), var(--copper-50)); }
  .product-card__img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .product-card:hover .product-card__img img { transform: scale(1.04); }
  .product-card__tag { position: absolute; top: .8rem; left: .8rem; z-index: 2; background: rgba(27,23,20,.82); color: #fff; font-family: var(--font-mono); font-size: .66rem; text-transform: uppercase; letter-spacing: .12em; padding: .35em .7em; border-radius: var(--radius-sm); }
  .product-card__body { padding: var(--sp-4) var(--sp-5); flex: 1; display: flex; flex-direction: column; gap: var(--sp-3); }
  .product-card__title { font-size: var(--font-lg); margin: 0; }
  .product-card__title a { color: var(--ink-900); }
  .product-card__title a:hover { color: var(--accent-text); }
  .product-card__foot { margin-top: auto; padding-top: var(--sp-3); border-top: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center; }
  .product-card__status { font-family: var(--font-mono); font-size: var(--font-xs); color: var(--color-text-muted); }
  .product-card__more { font-size: var(--font-sm); color: var(--accent-text); font-weight: 600; }
</style>
