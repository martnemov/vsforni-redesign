---
import Button from '../ui/Button.astro';
import { useTranslations, getLang } from '@/i18n';

const t = useTranslations(getLang(Astro.currentLocale));
const telHref = `tel:${t.phone.replace(/\s|\(|\)|-/g, '')}`;
---
<section class="leasing">
  <div class="container leasing__inner">
    <div class="leasing__text">
      <h2>{t.leasingHeading}</h2>
      <p>{t.leasingText}</p>
    </div>
    <div class="leasing__act">
      <Button variant="primary" size="lg" data-modal="modal-callback">{t.requestCall}</Button>
      <a href={telHref} class="leasing__phone">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
        {t.phone}
      </a>
    </div>
  </div>
</section>

<style>
  .leasing { background: var(--ink-900); color: var(--paper); position: relative; overflow: hidden; }
  .leasing::after { content: ""; position: absolute; inset: 0; background: radial-gradient(100% 90% at 100% 0, rgba(224,123,26,.26), transparent 60%); pointer-events: none; }
  .leasing__inner { position: relative; display: grid; grid-template-columns: 1.3fr .7fr; gap: var(--sp-6); align-items: center; }
  .leasing__text h2 { color: #fff; font-size: var(--font-2xl); margin: var(--sp-3) 0 var(--sp-4); max-width: 18ch; }
  .leasing__text p { color: var(--graphite-300); max-width: 44ch; }
  .leasing__act { display: flex; flex-direction: column; gap: var(--sp-4); align-items: flex-start; }
  .leasing__phone { color: #fff; font-family: var(--font-mono); font-size: var(--font-base); display: inline-flex; align-items: center; gap: .5em; }
  .leasing__phone svg { width: 1.05em; height: 1.05em; color: var(--copper-bright); }
  .leasing__phone:hover { color: var(--copper-bright); }
  @media (max-width: 767px) { .leasing__inner { grid-template-columns: 1fr; } }
</style>
