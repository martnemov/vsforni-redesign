---
import Button from '../ui/Button.astro';
import { useTranslations, getLang } from '@/i18n';
import { mediaUrl } from '@/lib/utils';
const t = useTranslations(getLang(Astro.currentLocale));
---
<section class="design">
  <div class="container design__inner">
    <div class="design__image">
      <img src={mediaUrl('/uploads/img/scheme.png')} alt={t.designImageAlt} loading="lazy" decoding="async" width="600" height="400" />
    </div>
    <div class="design__text">
      <h2>{t.designTitle}</h2>
      <p>{t.designText}</p>
      <Button variant="primary" size="lg" data-modal="modal-callback">{t.designCta}</Button>
    </div>
  </div>
</section>

<style>
  .design { background: var(--paper-2); border-block: 1px solid var(--color-border); }
  .design__inner { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 4vw, 4rem); align-items: center; }
  .design__text h2 { font-size: var(--font-2xl); margin: var(--sp-3) 0 var(--sp-4); }
  .design__text p { color: var(--color-text-muted); margin-bottom: var(--sp-6); max-width: 46ch; }
  .design__image { border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--color-border); box-shadow: var(--shadow-card); background: var(--surface); }
  .design__image img { width: 100%; height: auto; }
  @media (max-width: 767px) { .design__inner { grid-template-columns: 1fr; } .design__image { order: -1; } }
</style>
