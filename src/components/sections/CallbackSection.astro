---
import Button from '../ui/Button.astro';
import { useTranslations, getLang } from '../../i18n';

const t = useTranslations(getLang(Astro.currentLocale));
const telHref = `tel:${t.phone.replace(/\s|\(|\)|-/g, '')}`;
---
<section class="callback">
  <div class="container callback__inner">
    <div class="callback__text">
      <span class="kicker">{t.contacts}</span>
      <h2>{t.callbackTitle}</h2>
      <p>{t.callbackText}</p>
      <Button variant="primary" size="lg" data-modal="modal-callback">{t.requestCall}</Button>
    </div>
    <div class="callback__contacts">
      <a href={telHref} class="callback__phone">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
        {t.phone}
      </a>
      <a href={`mailto:${t.email}`} class="callback__email">{t.email}</a>
      <span class="callback__addr">{t.address}</span>
    </div>
  </div>
</section>

<style>
  .callback { background: var(--surface); border-top: 1px solid var(--color-border); }
  .callback__inner { display: grid; grid-template-columns: 1.2fr .8fr; gap: clamp(2rem, 4vw, 4rem); align-items: center; }
  .kicker { font-family: var(--font-mono); font-size: var(--font-xs); text-transform: uppercase; letter-spacing: .22em; color: var(--accent-text); display: inline-flex; align-items: center; gap: .6em; }
  .kicker::before { content: ""; width: 1.6em; height: 1px; background: var(--accent-text); }
  .callback__text h2 { font-size: var(--font-2xl); margin: var(--sp-3) 0 var(--sp-4); }
  .callback__text p { color: var(--color-text-muted); margin-bottom: var(--sp-6); max-width: 42ch; }
  .callback__contacts { display: flex; flex-direction: column; gap: var(--sp-3); padding: var(--sp-6); background: var(--paper-2); border: 1px solid var(--color-border); border-left: 3px solid var(--accent); border-radius: var(--radius-lg); }
  .callback__phone { font-family: var(--font-display); font-weight: 700; font-size: var(--font-xl); color: var(--ink-900); display: inline-flex; align-items: center; gap: .4em; }
  .callback__phone svg { width: .9em; height: .9em; color: var(--accent); }
  .callback__phone:hover { color: var(--accent-text); }
  .callback__email { color: var(--accent-text); font-family: var(--font-mono); font-size: var(--font-sm); }
  .callback__addr { color: var(--color-text-muted); font-family: var(--font-mono); font-size: var(--font-sm); }
  @media (max-width: 767px) { .callback__inner { grid-template-columns: 1fr; } }
</style>
