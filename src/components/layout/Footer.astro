---
import { useTranslations, getLang, localizeUrl } from '../../i18n';
import Logo from './Logo.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const L = (p: string) => localizeUrl(p, lang);
const catLinks = [
  '/katalog-oborudovaniya-vs-forni/avtomaticheskie-proizvodstvennyie-linii/',
  '/katalog-oborudovaniya-vs-forni/konditerskoe-oborudovanie/',
  '/katalog-oborudovaniya-vs-forni/testomesyi-s-oprokidyivaniem/',
  '/katalog-oborudovaniya-vs-forni/testopodgotovka/',
  '/katalog-oborudovaniya-vs-forni/pechi/',
  '/katalog-oborudovaniya-vs-forni/vspomogatelnoe-oborudovanie/',
];
const telHref = `tel:${t.phone.replace(/\s|\(|\)|-/g, '')}`;
const year = new Date().getFullYear();

const jsonLdOrg = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: t.siteName,
  url: 'https://vsforni.ru',
  telephone: t.phone,
  email: t.email,
  address: { '@type': 'PostalAddress', addressCountry: 'RU', addressLocality: 'Уфа' },
  sameAs: [
    'https://vk.com/vsforni',
    'https://t.me/vsforni',
  ],
};
---
<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href={L("/")} class="footer__logo" aria-label={t.siteName}><Logo height="24px" /></a>
      <p class="footer__tag">{t.footerTagline}</p>
      <p class="footer__80"><b>80</b> <span>{t.footer80Suffix}</span></p>
    </div>

    <nav class="footer__col" aria-label={t.catalog}>
      <h2 class="footer__h">{t.catalog}</h2>
      <ul>
        {catLinks.map((href, i) => <li><a href={L(href)}>{t.footerCatalogLinks[i]}</a></li>)}
      </ul>
    </nav>

    <nav class="footer__col" aria-label={t.company}>
      <h2 class="footer__h">{t.company}</h2>
      <ul>
        <li><a href={L("/istoriya-kompanii")}>{t.history}</a></li>
        <li><a href={L("/gallery/")}>{t.gallery}</a></li>
      </ul>
    </nav>

    <div class="footer__col footer__contacts-col">
      <h2 class="footer__h">{t.contacts}</h2>
      <address class="footer__contacts">
        <a href={telHref} class="footer__phone">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
          {t.phone}
        </a>
        <a href={`mailto:${t.email}`} class="footer__ln">{t.email}</a>
        <span class="footer__ln">{t.address}</span>
      </address>
    </div>
  </div>

  <div class="container footer__bottom">
    <span>© {year} {t.siteName}. {t.rightsReserved}</span>
    <span>{t.privacy}</span>
  </div>
</footer>
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdOrg)} />

<style>
  .footer { background: var(--ink-900); color: var(--graphite-300); border-top: 3px solid var(--accent); margin-top: auto; }
  .footer__grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.2fr; gap: var(--sp-6); padding-block: clamp(3rem, 5vw, 4.5rem) var(--sp-6); }
  .footer__logo { display: inline-flex; color: #fff; transition: color var(--transition); margin-bottom: var(--sp-4); }
  .footer__logo:hover { color: var(--copper-bright); }
  .footer__tag { color: var(--graphite-400); font-size: var(--font-sm); max-width: 32ch; margin-bottom: var(--sp-5); }
  .footer__80 { display: inline-flex; align-items: baseline; gap: .5rem; color: #fff; }
  .footer__80 b { font-family: var(--font-display); font-size: var(--font-xl); color: var(--copper-bright); font-weight: 700; }
  .footer__h { color: #fff; font-size: var(--font-sm); text-transform: uppercase; letter-spacing: .12em; font-family: var(--font-mono); font-weight: 500; margin-bottom: var(--sp-4); }
  .footer__col ul { display: grid; gap: var(--sp-3); }
  .footer__col a { color: var(--graphite-300); font-size: var(--font-sm); }
  .footer__col a:hover { color: var(--copper-bright); }
  .footer__contacts { font-style: normal; display: grid; gap: var(--sp-2); }
  .footer__phone { color: #fff; font-family: var(--font-mono); font-size: var(--font-base); display: inline-flex; align-items: center; gap: .5em; margin-bottom: var(--sp-2); }
  .footer__phone svg { width: 1.05em; height: 1.05em; color: var(--copper-bright); }
  .footer__phone:hover { color: var(--copper-bright); }
  .footer__ln { color: var(--graphite-300); font-size: var(--font-sm); }
  .footer__bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--sp-4); border-top: 1px solid var(--graphite-700); padding-block: var(--sp-5); font-size: var(--font-xs); color: var(--graphite-500); font-family: var(--font-mono); }

  @media (max-width: 900px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .footer__grid { grid-template-columns: 1fr; } }
</style>
