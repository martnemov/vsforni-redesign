---
// Counter ID comes from env. If not set, Metrika is not loaded.
const counterId = import.meta.env.YANDEX_METRIKA_ID;
if (!counterId) { /* noop */ }
---
{counterId && (
  <script define:vars={{ counterId }}>
    // Load Yandex Metrika after page is interactive, not during initial parse
    function loadMetrika() {
      (function(m,e,t,r,i,k,a){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        k=e.createElement(t),a=e.getElementsByTagName(t)[0];
        k.async=1;k.src=r;a.parentNode.insertBefore(k,a)
      })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');

      ym(counterId, 'init', {
        clickmap: true,
        trackLinks: true,
        accurateTrackBounce: true,
        webvisor: false,
      });
    }

    if ('requestIdleCallback' in window) {
      requestIdleCallback(loadMetrika, { timeout: 3000 });
    } else {
      setTimeout(loadMetrika, 1000);
    }
  </script>
  <noscript>
    <div>
      <img src={`https://mc.yandex.ru/watch/${counterId}`} style="position:absolute; left:-9999px;" alt="" width="1" height="1" />
    </div>
  </noscript>
)}
